  m_Name: TutorialDescriptions_pl
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: pl
  m_SharedData: {fileID: 11400000, guid: 787f9328ab1102f4dbe15593b57817be, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 112356413440
    m_Localized: "Poruszaj si\u0119, rzucaj zakl\u0119cia i r\xF3b uniki z doskokiem,
      aby unika\u0107 atak\xF3w i eliminowa\u0107 przeciwnik\xF3w."
    m_Metadata:
      m_Items: []
  - m_Id: 152374267904
    m_Localized: "Walcz na wielu mapach i zdobywaj punkty, pozostaj\u0105c ostatnim
      \u017Cywym graczem. Wygrywa ten, kto pierwszy osi\u0105gnie limit punkt\xF3w."
    m_Metadata:
      m_Items: []
  - m_Id: 196011806720
    m_Localized: "Podno\u015B zakl\u0119cia, rzucaj je, by atakowa\u0107, broni\u0107
      si\u0119 i ogrywa\u0107 przeciwnik\xF3w. U\u017Cywaj dw\xF3ch naraz, by tworzy\u0107
      komba."
    m_Metadata:
      m_Items: []
  - m_Id: 217025269760
    m_Localized: "Do 4 graczy walczy w trybie ka\u017Cdy na ka\u017Cdego, zdobywaj\u0105c
      punkty za pozostanie ostatnim na polu bitwy. Wygrywa gracz z najwi\u0119ksz\u0105
      liczb\u0105 punkt\xF3w."
    m_Metadata:
      m_Items: []
  - m_Id: 254539124736
    m_Localized: "Po\u0142\u0105czcie si\u0142y w bitwach 2v2 lub 3v1 i wsp\xF3\u0142pracujcie,
      aby pokona\u0107 przeciwn\u0105 dru\u017Cyn\u0119."
    m_Metadata:
      m_Items: []
  - m_Id: 282519326720
    m_Localized: "Wizzo Popout to dynamiczny,\\ntr\xF3jwymiarowy arena shooter z
      widokiem z g\xF3ry\\n dla maksymalnie 4 graczy.\\n\\nRzucaj zakl\u0119cia,
      unikaj wybuch\xF3w i wyrzucaj rywali z areny."
    m_Metadata:
      m_Items: []
  - m_Id: 319974461440
    m_Localized: "Podczas walki wok\xF3\u0142 \u015Brodka porusza si\u0119 wir. Przyci\u0105ga
      graczy do wn\u0119trza, spowalnia ruch i mo\u017Ce zabi\u0107, je\u015Bli zostan\u0105
      wci\u0105gni\u0119ci ca\u0142kowicie."
    m_Metadata:
      m_Items: []
  - m_Id: 354535526400
    m_Localized: "Podczas walki przez aren\u0119 przep\u0142ywaj\u0105 ryby. Poruszaj\u0105
      si\u0119 szybko przez \u015Brodek, blokuj\u0105c ruch i odrzucaj\u0105c graczy
      przy kontakcie."
    m_Metadata:
      m_Items: []
  - m_Id: 375968419840
    m_Localized: "Walcz, gdy z g\xF3ry kapi\u0105 krople myd\u0142a. Im d\u0142u\u017Cej
      trwa mecz, tym bardziej \u015Bliska i chaotyczna staje si\u0119 rozgrywka."
    m_Metadata:
      m_Items: []
  - m_Id: 398634438656
    m_Localized: "Podczas walki z do\u0142u wy\u0142ania si\u0119 jedzenie. Pojawia
      si\u0119 losowo, blokuje zakl\u0119cia i odrzuca graczy podczas unoszenia si\u0119."
    m_Metadata:
      m_Items: []
  - m_Id: 425184382976
    m_Localized: "Szybkie zakl\u0119cie o kr\xF3tkim zasi\u0119gu i kr\xF3tkim czasie
      odnowienia"
    m_Metadata:
      m_Items: []
  - m_Id: 463079919616
    m_Localized: "Obszarowe zakl\u0119cie zadaj\u0105ce obra\u017Cenia i odrzucaj\u0105ce"
    m_Metadata:
      m_Items: []
  - m_Id: 492343578624
    m_Localized: "Exploduje przy uderzeniu, du\u017Ce obra\u017Cenia obszarowe"
    m_Metadata:
      m_Items: []
  - m_Id: 521196195840
    m_Localized: "Kurcz\u0105ca si\u0119, przyspieszaj\u0105ca kula o du\u017Cej
      sile uderzenia"
    m_Metadata:
      m_Items: []
  - m_Id: 546617872384
    m_Localized: "Lobowana granat z wybuchem os\u0142abiaj\u0105cym"
    m_Metadata:
      m_Items: []
  - m_Id: 573285257216
    m_Localized: "Przyci\u0105ga wrog\xF3w do wn\u0119trza, umiarkowane obra\u017Cenia"
    m_Metadata:
      m_Items: []
  - m_Id: 602712494080
    m_Localized: "Namierzaj\u0105cy pocisk o niskich obra\u017Ceniach"
    m_Metadata:
      m_Items: []
  - m_Id: 629505708032
    m_Localized: "Szybka, sze\u015Bciostrza\u0142owa salwa z rewolweru o du\u017Cym
      rozrzucie"
    m_Metadata:
      m_Items: []
  - m_Id: 655795605504
    m_Localized: "Dwa kr\u0105\u017C\u0105ce pociski odrzucaj\u0105ce"
    m_Metadata:
      m_Items: []
  - m_Id: 685206065152
    m_Localized: "Precyzyjny strza\u0142 snajperski o du\u017Cym zasi\u0119gu z skalowaniem"
    m_Metadata:
      m_Items: []
  - m_Id: 717250547712
    m_Localized: "\u015Aliskie pole zwi\u0119kszaj\u0105ce podatno\u015B\u0107 na
      odrzucenie"
    m_Metadata:
      m_Items: []
  - m_Id: 741921443840
    m_Localized: "Post\u0119puj\u0105ca \u015Bciana, kt\xF3ra blokuje i odpycha wrog\xF3w"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
