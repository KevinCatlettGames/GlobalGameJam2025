  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: TutorialDescriptions_it
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: it
  m_SharedData: {fileID: 11400000, guid: 787f9328ab1102f4dbe15593b57817be, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 112356413440
    m_Localized: Muoviti, lancia incantesimi e scatta per schivare gli attacchi e
      mettere fuori gioco gli avversari.
    m_Metadata:
      m_Items: []
  - m_Id: 152374267904
    m_Localized: "Usa i tuoi <color=#FFF8A1>2 Incantesimi</color> per spingere gli
      Avversari fuori dall'Arena.\r\n\r\n<color=#CB98ED>Raccogli</color> nuovi Incantesimi
      da Terra, questo azzerer\xE0 il loro <color=#CB98ED>Tempo di ricarica</color>.\r\n\r\nColpisci
      i Giocatori con gli Incantesimi per\r\naccumulare <color=#FF3D5E>Danno</color>.
      Pi\xF9 Danno\r\nhanno, pi\xF9 lontano verranno<color=#FF3D5E> sbalzati via</color>.
      \r\n\r\nMetti alla prova gli Incantesimi nel <color=#FFF8A1>Campo d'allenamento</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 196011806720
    m_Localized: "Fino a <color=#CB98ED>4 Giocatori</color> competono in battaglie
      <color=#CB98ED>tutti contro tutti</color> o a <color=#CB98ED>Squadre</color>.
      \nGuadagna Punti essendo l'\n<color=#CB98ED>ultimo rimasto in piedi</color>.
      \nIl Giocatore con pi\xF9 Punti vince.\n\nModifica le <color=#FFF8A1>Impostazioni
      della partita</color> nella Lobby per creare Turni personalizzati.\n\nSblocca
      <color=#FFF8A1>nuovi Wizzo</color> giocando e completando gli <color=#FFF8A1>Obiettivi</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 217025269760
    m_Localized: "Fino a 4 giocatori si sfidano in un tutti contro tutti, ottenendo
      punti restando l'ultimo in vita. Il giocatore con pi\xF9 punti vince."
    m_Metadata:
      m_Items: []
  - m_Id: 254539124736
    m_Localized: "<color=#86D1F0>Scivoloso $</color> - Aumenta il Respingimento sui
      Giocatori e la Velocit\xE0 delle Bolle.\n\n<color=#FFA845>Piccante {</color>
      - Applica un Marchio. Il colpo successivo attiver\xE0 il Marchio infliggendo
      Danno e Respingimento bonus.\n\n<color=#FFA1F9>Rallentato }</color> - Sia i
      Wizzo che le Bolle si muovono pi\xF9 lentamente. I Wizzo non possono usare
      lo Scatto."
    m_Metadata:
      m_Items: []
  - m_Id: 282519326720
    m_Localized: "Wizzo Popout \xE8 un frenetico\\narena shooter 3D con visuale dall'alto\\n
      per un massimo di 4 giocatori.\\n\\nLancia incantesimi, schiva le esplosioni
      e scaraventa i rivali fuori dall'arena."
    m_Metadata:
      m_Items: []
  - m_Id: 319974461440
    m_Localized: "Nel bel mezzo di una rilassante giornata in spiaggia, i Wizzo perdono
      le staffe. \nAttenzione! Su questa spiaggia\nnon tutto \xE8 come sembra.\n\n<color=#FF5162>Evento
      Mappa:</color> Astute Vongole attirano i Wizzo con finti oggetti. Quando ci
      si avvicina troppo, le Vongole si chiudono di scatto, infliggendo ingenti danni."
    m_Metadata:
      m_Items: []
  - m_Id: 354535526400
    m_Localized: 'Le strade non sono sicure! Un gruppo di Wizzo in rivolta risolve
      i propri conflitti in una scatola di tonno piena di acqua piovana e avanzi
      spaventosi.


      <color=#5FFF6A>Evento Mappa:</color> Lische di pesce girano
      attorno alla Scatola, creando barriere in movimento. All''impatto respingono
      sia i colpi che i Wizzo.'
    m_Metadata:
      m_Items: []
  - m_Id: 375968419840
    m_Localized: "L'originale Wizzo Popout:\nPiatti sporchi nel lavello della cucina
      \nDopo essere stati rimpiccioliti per errore, \xE8 ora di risolvere la disputa
      una volta per tutte: a chi tocca lavare i piatti?\n\n<color=#5AE2FF>Evento
      Mappa:</color> Ondate di Pioggia insaponata schizzano sul piatto lasciando
      il pavimento bagnato e <color=#5AE2FF>scivoloso $</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 398634438656
    m_Localized: 'Mentre la loro discussione infinita prosegue, i Wizzo si ritrovano
      a combattere nel calore di uno stufato appena mescolato.


      <color=#FFA845>Evento
      Mappa:</color> Pezzi di Cibo salgono dal fondo, creando elementi di pareti
      e barriere in continuo cambiamento. Zone extra calde e <color=#FFA845>piccanti
      {</color> marchiano i Wizzo.'
    m_Metadata:
      m_Items: []
  - m_Id: 425184382976
    m_Localized: 'Spara una Bolla <color=#86D1F0>veloce</color>

      a medio raggio

      e
      con un <color=#86D1F0>tempo di ricarica molto basso</color>.'
    m_Metadata:
      m_Items: []
  - m_Id: 463079919616
    m_Localized: 'Lancia una Gomma da masticare esplosiva

      a corto raggio.

      Lascia
      un <color=#FCABFC>campo di rallentamento }</color> alle spalle.'
    m_Metadata:
      m_Items: []
  - m_Id: 492343578624
    m_Localized: 'Lancia un Missile.

      <color=#FFA975>Esplode</color> all''impatto
      in un''

      area d''effetto.'
    m_Metadata:
      m_Items: []
  - m_Id: 521196195840
    m_Localized: "Evoca una Barca lenta \nche infligge un <color=#7DFFBB>imponente
      respingimento</color>. \nSe colpita, si trasforma nel pi\xF9 piccolo Motoscafo."
    m_Metadata:
      m_Items: []
  - m_Id: 546617872384
    m_Localized: 'Lancia una Granata ad arco.

      Esplode in un''area d''effetto.

      Lascia
      un <color=#FFFF7B5C>campo di salsa {</color> che marchia i giocatori.'
    m_Metadata:
      m_Items: []
  - m_Id: 573285257216
    m_Localized: Attira i nemici verso l'interno, danno moderato
    m_Metadata:
      m_Items: []
  - m_Id: 602712494080
    m_Localized: "Evoca un Pipistrello <color=#FF6EF5>a ricerca automatica</color>.
      \nAggancia i giocatori.\nInfligge danni all'impatto\ne dopo un breve ritardo."
    m_Metadata:
      m_Items: []
  - m_Id: 629505708032
    m_Localized: 'Estrae un Revolver

      scaricando <color=#A178FF>6</color> piccoli
      proiettili

      a <color=#A178FF>ventaglio</color>.'
    m_Metadata:
      m_Items: []
  - m_Id: 655795605504
    m_Localized: "Crea una coppia di Bolle\nche <color=#FF7D87>ruotano attorno</color>
      al giocatore.\nIl <color=#FF7D87>secondo</color> colpo sullo stesso bersaglio
      metter\xE0 a segno un <color=#FF7D87>critico</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 685206065152
    m_Localized: "Spara un colpo da Cecchino a <color=#E05C9A>lungo raggio</color>.\nIl
      danno aumenta con la distanza. \n<color=#E05C9A>Trafigge</color> le altre bolle."
    m_Metadata:
      m_Items: []
  - m_Id: 717250547712
    m_Localized: "Lancia una goccia di Sapone.\nLascia dei <color=#8CA7FC>campi scivolosi
      $</color> alle spalle \naumentando la velocit\xE0 delle bolle\ne il respingimento
      sui giocatori."
    m_Metadata:
      m_Items: []
  - m_Id: 741921443840
    m_Localized: 'Evoca un Muro in movimento.

      <color=#FFF373>Riflette</color>
      i colpi all''impatto.'
    m_Metadata:
      m_Items: []
  - m_Id: 16121243400871936
    m_Localized: "Scaglia un proiettile Cactus,\nche si <color=#BBFF7A>divide in
      due</color> spine pi\xF9 pericolose."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
