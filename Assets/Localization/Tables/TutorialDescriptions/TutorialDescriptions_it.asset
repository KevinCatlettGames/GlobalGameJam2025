  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: TutorialDescriptions_it
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: it
  m_SharedData: {fileID: 11400000, guid: 787f9328ab1102f4dbe15593b57817be, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 112356413440
    m_Localized: Muoviti, lancia incantesimi e scatta per schivare gli attacchi e
      mettere fuori gioco gli avversari.
    m_Metadata:
      m_Items: []
  - m_Id: 152374267904
    m_Localized: "Combatti su pi\xF9 mappe, ottieni punti restando l'ultimo giocatore
      in vita. Il primo a raggiungere il limite di punteggio vince."
    m_Metadata:
      m_Items: []
  - m_Id: 196011806720
    m_Localized: Raccogli gli incantesimi, lanciali per attaccare, difenderti e superare
      in astuzia gli avversari. Usane due contemporaneamente per creare combo.
    m_Metadata:
      m_Items: []
  - m_Id: 217025269760
    m_Localized: "Fino a 4 giocatori si sfidano in un tutti contro tutti, ottenendo
      punti restando l'ultimo in vita. Il giocatore con pi\xF9 punti vince."
    m_Metadata:
      m_Items: []
  - m_Id: 254539124736
    m_Localized: Fai squadra in battaglie 2v2 o 3v1 e collabora per sconfiggere la
      squadra avversaria.
    m_Metadata:
      m_Items: []
  - m_Id: 282519326720
    m_Localized: "Wizzo Popout \xE8 un frenetico\\narena shooter 3D con visuale dall'alto\\n
      per un massimo di 4 giocatori.\\n\\nLancia incantesimi, schiva le esplosioni
      e scaraventa i rivali fuori dall'arena."
    m_Metadata:
      m_Items: []
  - m_Id: 319974461440
    m_Localized: "Un vortice si muove attorno al centro durante il combattimento.
      Attira i giocatori verso l'interno, ne rallenta i movimenti e pu\xF2 ucciderli
      se vengono risucchiati completamente."
    m_Metadata:
      m_Items: []
  - m_Id: 354535526400
    m_Localized: Alcuni pesci nuotano nell'arena durante il combattimento. Si muovono
      rapidamente al centro, bloccando i movimenti e respingendo i giocatori al contatto.
    m_Metadata:
      m_Items: []
  - m_Id: 375968419840
    m_Localized: "Combatti mentre dal cielo piovono gocce di sapone. Pi\xF9 dura
      la partita, pi\xF9 diventa scivolosa e caotica."
    m_Metadata:
      m_Items: []
  - m_Id: 398634438656
    m_Localized: Il cibo sale dal basso durante il combattimento. Compare casualmente,
      blocca gli incantesimi e respinge i giocatori mentre sale.
    m_Metadata:
      m_Items: []
  - m_Id: 425184382976
    m_Localized: Incantesimo rapido a corto raggio con ricarica breve
    m_Metadata:
      m_Items: []
  - m_Id: 463079919616
    m_Localized: Incantesimo ad area con danno e respingimento
    m_Metadata:
      m_Items: []
  - m_Id: 492343578624
    m_Localized: Esplode all'impatto, ingenti danni ad area
    m_Metadata:
      m_Items: []
  - m_Id: 521196195840
    m_Localized: Sfera che si rimpicciolisce, accelera e ha un forte impatto
    m_Metadata:
      m_Items: []
  - m_Id: 546617872384
    m_Localized: Granata a parabola con esplosione di debuff
    m_Metadata:
      m_Items: []
  - m_Id: 573285257216
    m_Localized: Attira i nemici verso l'interno, danno moderato
    m_Metadata:
      m_Items: []
  - m_Id: 602712494080
    m_Localized: Proiettile a ricerca automatica con danno basso
    m_Metadata:
      m_Items: []
  - m_Id: 629505708032
    m_Localized: Raffica rapida di revolver a sei colpi a ventaglio
    m_Metadata:
      m_Items: []
  - m_Id: 655795605504
    m_Localized: Due proiettili orbitanti con respingimento
    m_Metadata:
      m_Items: []
  - m_Id: 685206065152
    m_Localized: Tiro da cecchino di precisione a lungo raggio con scaling
    m_Metadata:
      m_Items: []
  - m_Id: 717250547712
    m_Localized: "Terreno scivoloso che aumenta la vulnerabilit\xE0 al respingimento"
    m_Metadata:
      m_Items: []
  - m_Id: 741921443840
    m_Localized: Muro in avanzamento che blocca e spinge i nemici
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
