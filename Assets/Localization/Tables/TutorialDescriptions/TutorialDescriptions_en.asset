  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: TutorialDescriptions_en
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 787f9328ab1102f4dbe15593b57817be, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 546617872384
    m_Localized: 'Throws a Granato in an arc.

      Explodes in an area of effect.

      Leaves
      behind a sauce field marking players.'
    m_Metadata:
      m_Items: []
  - m_Id: 112356413440
    m_Localized: Move, cast spells, and dash to dodge attacks and knock opponents
      out.
    m_Metadata:
      m_Items: []
  - m_Id: 152374267904
    m_Localized: Battle across multiple maps, earning points by being the last player
      standing. The first to reach the score limit wins.
    m_Metadata:
      m_Items: []
  - m_Id: 196011806720
    m_Localized: Pick up spells, cast them to attack, defend, and outplay opponents.
      Use two at once to build combos.
    m_Metadata:
      m_Items: []
  - m_Id: 217025269760
    m_Localized: Up to 4 players battle in a free-for-all, earning points by being
      the last one standing. The player with the most points wins.
    m_Metadata:
      m_Items: []
  - m_Id: 254539124736
    m_Localized: Team up in 2v2 or 3v1 battles and work together to defeat the opposing
      team.
    m_Metadata:
      m_Items: []
  - m_Id: 282519326720
    m_Localized: Wizzo Popout is a fast-paced,\n3D top-down arena shooter\n for up
      to 4 players.\n\nCast spells, dodge blasts, and knock your rivals out of the
      arena.
    m_Metadata:
      m_Items: []
  - m_Id: 319974461440
    m_Localized: "In the middle of a relaxing beach day the Wizzos crash out. \nBeware!
      On this beach\nnot everything is as it seems.\n\nMap Event: Cunning Clams lure
      the Wizzos with fake items. When getting too close Clams will snap, inflicting
      substantial damage."
    m_Metadata:
      m_Items: []
  - m_Id: 354535526400
    m_Localized: 'The Streets aren''t safe! A bunch of rioting Wizzos settle their
      conflict in a Tuna-Can filled with rainwater and spooky leftovers.


      Map
      Event: Fishbones circle the Can, creating moving barriers. On impact they reflect
      both shots and Wizzos.'
    m_Metadata:
      m_Items: []
  - m_Id: 375968419840
    m_Localized: "The Wizzo Popout original:\nDirty Dishes in the Kitchen Sink \nAfter
      being shrunk on accident, it's time to settle their dispute once and for all:
      who is on cleaning duty?\n\nMap Event: Waves of soapy Rain splash onto the
      plate leaving the floor wet and slippery."
    m_Metadata:
      m_Items: []
  - m_Id: 398634438656
    m_Localized: 'As their neverending argument continues, the Wizzos find themselves
      battling in the heat of a freshly stirred stew.


      Map Event: Pieces of
      Food rise from below, creating changing patterns of walls and barriers. Extra
      hot bubbling zones mark Wizzos, creating additional danger. '
    m_Metadata:
      m_Items: []
  - m_Id: 425184382976
    m_Localized: 'Shoots a fast Bubble

      with medium range

      and very low
      cooldown.'
    m_Metadata:
      m_Items: []
  - m_Id: 463079919616
    m_Localized: 'Casts a bursting Bubblegum

      at close range.

      Leaves
      a slowing field behind.'
    m_Metadata:
      m_Items: []
  - m_Id: 492343578624
    m_Localized: 'Launches a Missile.

      Explodes on impact in an

      area
      of effect.'
    m_Metadata:
      m_Items: []
  - m_Id: 521196195840
    m_Localized: "Summons a slow Boat \ndealing massive knockback. \nWhen hit, transforms
      into the smaller Speed-Boat."
    m_Metadata:
      m_Items: []
  - m_Id: 573285257216
    m_Localized: Pulls enemies inward, moderate damage
    m_Metadata:
      m_Items: []
  - m_Id: 602712494080
    m_Localized: "Summons a Homing Bat. \nLocks onto players.\nDamages on impact\nand
      after a short delay."
    m_Metadata:
      m_Items: []
  - m_Id: 629505708032
    m_Localized: 'Whips out a Revolver

      unloading 6 small bullets

      in
      a spread.'
    m_Metadata:
      m_Items: []
  - m_Id: 655795605504
    m_Localized: 'Creates a pair of Bubbles

      spinning around the player.'
    m_Metadata:
      m_Items: []
  - m_Id: 685206065152
    m_Localized: "Fires a long-range Sniper shot.\nDamage scales with distance. \nPierces
      other bubbles."
    m_Metadata:
      m_Items: []
  - m_Id: 717250547712
    m_Localized: "Lobs a drop of Soap.\nLeaves slippery fields behind \nincreasing
      the speed of bubbles\nand knockback on players."
    m_Metadata:
      m_Items: []
  - m_Id: 741921443840
    m_Localized: 'Summons a moving Wall.

      Reflects shots on impact.'
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
