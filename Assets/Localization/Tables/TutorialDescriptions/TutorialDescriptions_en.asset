  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: TutorialDescriptions_en
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 787f9328ab1102f4dbe15593b57817be, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 546617872384
    m_Localized: 'Throws a Granato in an arc.

      Explodes in an area of effect.

      Leaves
      behind a <color=#FF7B5C>sauce field {</color> marking players.'
    m_Metadata:
      m_Items: []
  - m_Id: 112356413440
    m_Localized: '!display controls graphics over full screen!'
    m_Metadata:
      m_Items: []
  - m_Id: 152374267904
    m_Localized: 'How to Play:

      Hit Wizzos with Spells to build up Damage on
      them.

      The more Damage they have, the farther they will be knocked back.
      Use both your Spells to knock your Opponents out of the Arena.

'
    m_Metadata:
      m_Items: []
  - m_Id: 196011806720
    m_Localized: 'Find new ways to experience Wizzo Popout by changing the Match
      Settings in the Lobby. Create starting loadouts, switch to Teammode or disable
      certain Spells among others.


      Unlock a variety of new Wizzos by playing
      and completing Achievements.'
    m_Metadata:
      m_Items: []
  - m_Id: 217025269760
    m_Localized: "Up to 4 Players compete \nin free-for-all or \nTeam-based battles,
      \nearning Points by being the last one standing. \nThe Player with the most
      Points wins."
    m_Metadata:
      m_Items: []
  - m_Id: 254539124736
    m_Localized: '<color=#86D1F0>Slippery $</color> - Increases Knockback and Speed
      of Bubbles by +50%.


      <color=#FFA845>Saucy {</color> - Applies a Mark.
      The next hit will trigger the Mark dealing +50% Damage and Knockback.


      <color=#FFA1F9>Slowed
      }</color> - Both Wizzos and Bubbles move 25% slower. Wizzos are unable to use
      Dash.'
    m_Metadata:
      m_Items: []
  - m_Id: 282519326720
    m_Localized: 'Welcome to Wizzo Popout!

      a fast-paced arena brawler

      for
      up to 4 players.


      In this Tutorial Section you will find:

      - How
      to Play

      - Controls

      - Modes

      - Customize

      - Status
      Effects

      - Overviews of Spells

      - Overviews of the Maps

'
    m_Metadata:
      m_Items: []
  - m_Id: 319974461440
    m_Localized: "In the middle of a relaxing beach day the Wizzos crash out. \nBeware!
      On this beach\nnot everything is as it seems.\n\n<color=#FF5162>Map Event:</color>
      Cunning Clams lure the Wizzos with fake items. When getting too close Clams
      will snap, inflicting substantial damage."
    m_Metadata:
      m_Items: []
  - m_Id: 354535526400
    m_Localized: 'The Streets aren''t safe! A bunch of rioting Wizzos settle their
      conflict in a Tuna-Can filled with rainwater and spooky leftovers.


      <color=#5FFF6A>Map
      Event:</color> Fishbones circle the Can, creating moving barriers. On impact
      they reflect both shots and Wizzos.'
    m_Metadata:
      m_Items: []
  - m_Id: 375968419840
    m_Localized: "The Wizzo Popout original:\nDirty Dishes in the Kitchen Sink \nAfter
      being shrunk on accident, it's time to settle their dispute once and for all:
      who is on cleaning duty?\n\n<color=#5AE2FF>Map Event:</color> Waves of soapy
      Rain splash onto the plate leaving the floor wet and <color=#5AE2FF>slippery
      $</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 398634438656
    m_Localized: 'As their neverending argument continues, the Wizzos find themselves
      battling in the heat of a freshly stirred stew.


      <color=#FFA845>Map
      Event:</color> Pieces of Food rise from below, creating changing patterns of
      walls and barriers. Extra hot<color=#FFA845> saucy { </color>zones mark Wizzos,
      creating additional danger. '
    m_Metadata:
      m_Items: []
  - m_Id: 425184382976
    m_Localized: 'Shoots a <color=#86D1F0>fast</color> Bubble

      with medium
      range

      and very<color=#86D1F0> low cooldown</color>.'
    m_Metadata:
      m_Items: []
  - m_Id: 463079919616
    m_Localized: 'Casts a bursting Bubblegum

      at close range.

      Leaves
      a <color=#FCABFC>slowing field }</color> behind.'
    m_Metadata:
      m_Items: []
  - m_Id: 492343578624
    m_Localized: 'Launches a Missile.

      <color=#FFA975>Explodes</color> on impact
      in an

      area of effect.'
    m_Metadata:
      m_Items: []
  - m_Id: 521196195840
    m_Localized: "Summons a slow Boat \ndealing <color=#7DFFBB>massive knockback</color>.
      \nWhen hit, transforms into the smaller Speed-Boat."
    m_Metadata:
      m_Items: []
  - m_Id: 573285257216
    m_Localized: Pulls enemies inward, moderate damage
    m_Metadata:
      m_Items: []
  - m_Id: 602712494080
    m_Localized: "Summons a <color=#FF6EF5>homing</color> Bat. \nLocks onto players.\nDamages
      on impact\nand after a short delay."
    m_Metadata:
      m_Items: []
  - m_Id: 629505708032
    m_Localized: 'Whips out a Revolver

      unloading <color=#A178FF>6</color>
      small bullets

      in a <color=#A178FF>spread</color>.'
    m_Metadata:
      m_Items: []
  - m_Id: 655795605504
    m_Localized: 'Creates a pair of Bubbles

      <color=#FF7D87>spinning around</color>
      the player.'
    m_Metadata:
      m_Items: []
  - m_Id: 685206065152
    m_Localized: "Fires a <color=#E05C9A>long-range</color> Sniper shot.\nDamage
      scales with distance. \n<color=#E05C9A>Pierces</color> other bubbles."
    m_Metadata:
      m_Items: []
  - m_Id: 717250547712
    m_Localized: "Lobs a drop of Soap.\nLeaves <color=#8CA7FC>slippery fields $</color>
      behind \nincreasing the speed of bubbles\nand knockback on players."
    m_Metadata:
      m_Items: []
  - m_Id: 741921443840
    m_Localized: 'Summons a moving Wall.

      <color=#FFF373>Reflects</color> shots
      on impact.'
    m_Metadata:
      m_Items: []
  - m_Id: 16121243400871936
    m_Localized: 'Hurls a Cactus projectile,

      <color=#BBFF7A>splitting into
      two</color> more dangerous spikes.'
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
