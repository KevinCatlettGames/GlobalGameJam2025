  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: TutorialDescriptions_pt-BR
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: pt-BR
  m_SharedData: {fileID: 11400000, guid: 787f9328ab1102f4dbe15593b57817be, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 112356413440
    m_Localized: "Mova-se, lance feiti\xE7os e use a arrancada para esquivar de ataques
      e nocautear seus oponentes."
    m_Metadata:
      m_Items: []
  - m_Id: 152374267904
    m_Localized: "Batalhe em v\xE1rios mapas e ganhe pontos sendo o \xFAltimo sobrevivente.
      O primeiro a atingir o limite de pontos vence."
    m_Metadata:
      m_Items: []
  - m_Id: 196011806720
    m_Localized: "Pegue feiti\xE7os e use-os para atacar, defender e superar seus
      oponentes. Use dois ao mesmo tempo para criar combos."
    m_Metadata:
      m_Items: []
  - m_Id: 217025269760
    m_Localized: "At\xE9 4 jogadores batalham em um todos contra todos, ganhando
      pontos ao ser o \xFAltimo sobrevivente. O jogador com mais pontos vence."
    m_Metadata:
      m_Items: []
  - m_Id: 254539124736
    m_Localized: "Forme equipes em batalhas 2v2 ou 3v1 e trabalhem juntos para derrotar
      o time advers\xE1rio."
    m_Metadata:
      m_Items: []
  - m_Id: 282519326720
    m_Localized: "Wizzo Popout \xE9 um din\xE2mico\\nshooter de arena 3D com vis\xE3o
      isom\xE9trica\\n para at\xE9 4 jogadores.\\n\\nLance feiti\xE7os, desvie de
      explos\xF5es e jogue seus rivais para fora da arena."
    m_Metadata:
      m_Items: []
  - m_Id: 319974461440
    m_Localized: "Um v\xF3rtice se move ao redor do centro durante a luta. Ele puxa
      os jogadores para dentro, reduz a velocidade de movimento e pode matar se voc\xEA
      for totalmente sugado."
    m_Metadata:
      m_Items: []
  - m_Id: 354535526400
    m_Localized: "Peixes nadam pela arena durante a luta. Eles se movem r\xE1pido
      pelo centro, bloqueando a movimenta\xE7\xE3o e causando repuls\xE3o ao contato."
    m_Metadata:
      m_Items: []
  - m_Id: 375968419840
    m_Localized: "Batalhe enquanto gotas de sab\xE3o caem do c\xE9u. Quanto mais
      tempo a partida durar, mais escorregadia e ca\xF3tica ela se tornar\xE1."
    m_Metadata:
      m_Items: []
  - m_Id: 398634438656
    m_Localized: "Comida sobe de baixo durante a luta. Ela surge aleatoriamente,
      bloqueia feiti\xE7os e causa repuls\xE3o conforme sobe."
    m_Metadata:
      m_Items: []
  - m_Id: 425184382976
    m_Localized: "Feiti\xE7o r\xE1pido de curto alcance e baixa recarga"
    m_Metadata:
      m_Items: []
  - m_Id: 463079919616
    m_Localized: "Feiti\xE7o de \xE1rea de efeito com dano e repuls\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 492343578624
    m_Localized: "Explode ao impacto, alto dano em \xE1rea"
    m_Metadata:
      m_Items: []
  - m_Id: 521196195840
    m_Localized: Orbe que encolhe, acelera e causa grande impacto
    m_Metadata:
      m_Items: []
  - m_Id: 546617872384
    m_Localized: "Granada lan\xE7ada em par\xE1bola com explos\xE3o de penalidade"
    m_Metadata:
      m_Items: []
  - m_Id: 573285257216
    m_Localized: Puxa os inimigos para dentro, dano moderado
    m_Metadata:
      m_Items: []
  - m_Id: 602712494080
    m_Localized: "Proj\xE9til guiado de baixo dano"
    m_Metadata:
      m_Items: []
  - m_Id: 629505708032
    m_Localized: "Rajada r\xE1pida de rev\xF3lver de seis disparos com dispers\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 655795605504
    m_Localized: "Dois proj\xE9teis orbitais com repuls\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 685206065152
    m_Localized: "Tiro de precis\xE3o de longo alcance estilo sniper com escalonamento"
    m_Metadata:
      m_Items: []
  - m_Id: 717250547712
    m_Localized: "Campo escorregadio que aumenta a vulnerabilidade a repuls\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 741921443840
    m_Localized: "Parede avan\xE7ada que bloqueia e empurra os inimigos"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
