  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: TutorialDescriptions_fr
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: fr
  m_SharedData: {fileID: 11400000, guid: 787f9328ab1102f4dbe15593b57817be, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 112356413440
    m_Localized: "D\xE9placez-vous, lancez des sorts et foncez pour esquiver les
      attaques et \xE9liminer vos adversaires."
    m_Metadata:
      m_Items: []
  - m_Id: 152374267904
    m_Localized: "Utilisez vos <color=#FFF8A1>2 Sorts</color> pour \xE9jecter vos
      Adversaires de l'Ar\xE8ne.\r\n\r\n<color=#CB98ED>Ramassez</color> de nouveaux
      Sorts au Sol, cela r\xE9initialisera \nleur <color=#CB98ED>Temps de recharge</color>.\r\n\r\nTouchez
      les Joueurs avec \ndes Sorts pour accumuler \ndes <color=#FF3D5E>D\xE9g\xE2ts</color>.
      Plus ils ont de\r\nD\xE9g\xE2ts, plus ils \nseront<color=#FF3D5E> projet\xE9s
      loin</color>. \r\n\r\nTestez les Sorts sur le <color=#FFF8A1>Terrain d'entra\xEEnement</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 196011806720
    m_Localized: "Jusqu'\xE0 <color=#CB98ED>4 Joueurs</color> s'affrontent en <color=#CB98ED>m\xEAl\xE9e
      g\xE9n\xE9rale</color> ou lors de combats en <color=#CB98ED>\xC9quipe</color>.
      \nGagnez des Points en \xE9tant le\n<color=#CB98ED>dernier survivant</color>.
      \nLe Joueur avec le plus de Points gagne.\n\nModifiez les <color=#FFF8A1>Param\xE8tres
      du match</color> dans le Salon pour cr\xE9er des Manches personnalis\xE9es.\n\nD\xE9bloquez
      de <color=#FFF8A1>nouveaux Wizzos</color> en jouant et en accomplissant des
      <color=#FFF8A1>Succ\xE8s</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 217025269760
    m_Localized: "Jusqu'\xE0 4 joueurs s'affrontent dans un chacun pour soi, gagnant
      des points en \xE9tant le dernier survivant. Le joueur avec le plus de points
      gagne."
    m_Metadata:
      m_Items: []
  - m_Id: 254539124736
    m_Localized: "<color=#86D1F0>Glissant $</color> - Augmente la Projection des
      Joueurs et la Vitesse des Bulles.\n\n<color=#FFA845>Piquant {</color> - Applique
      une Marque. Le prochain coup d\xE9clenchera la Marque, infligeant des D\xE9g\xE2ts
      et une Projection bonus.\n\n<color=#FFA1F9>Ralenti }</color> - Les Wizzos et
      les Bulles se d\xE9placent plus lentement. Les Wizzos ne peuvent pas utiliser
      la Ru\xE9e."
    m_Metadata:
      m_Items: []
  - m_Id: 282519326720
    m_Localized: "Wizzo Popout est un jeu de tir en ar\xE8ne 3D\\nvue de dessus et
      au rythme effr\xE9n\xE9\\n pour jusqu'\xE0 4 joueurs.\\n\\nLancez des sorts,
      esquivez les explosions et \xE9jectez vos rivaux hors de l'ar\xE8ne."
    m_Metadata:
      m_Items: []
  - m_Id: 319974461440
    m_Localized: "En plein milieu d'une journ\xE9e de d\xE9tente \xE0 la plage, les
      Wizzos p\xE8tent les plombs. \nAttention! Sur cette plage,\ntout n'est pas
      ce qu'il para\xEEt.\n\n<color=#FF5162>\xC9v\xE9nement della Carte:</color>
      Des Clams rus\xE9es attirent les Wizzos avec de faux objets. S'ils s'approchent
      trop pr\xE8s, les Clams se referment brusquement, infligeant de lourds d\xE9g\xE2ts."
    m_Metadata:
      m_Items: []
  - m_Id: 354535526400
    m_Localized: "Les rues ne sont pas s\xFBres! Une bande de Wizzos en \xE9meute
      r\xE8gle ses comptes dans une bo\xEEte de thon remplie d'eau de pluie et de
      restes effrayants.\n\n<color=#5FFF6A>\xC9v\xE9nement de la Carte:</color> Des
      ar\xEAtes de poisson tournent autour de la Bo\xEEte, cr\xE9ant des obstacles
      mobiles. \xC0 l'impact, elles renvoient aussi bien les tir que les Wizzos."
    m_Metadata:
      m_Items: []
  - m_Id: 375968419840
    m_Localized: "L'original de Wizzo Popout:\nVaisselle sale dans l'\xE9vier de
      la cuisine \nApr\xE8s avoir \xE9t\xE9 r\xE9tr\xE9cis par accident, il est temps
      de r\xE9gler leur diff\xE9rend une bonne fois pour toutes: qui s'occupe de
      la vaisselle?\n\n<color=#5AE2FF>\xC9v\xE9nement de la Carte:</color> Des vagues
      de Pluie savonneuse s'\xE9claboussent sur l'assiette, rendant le sol mouill\xE9
      \net <color=#5AE2FF>glissant $</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 398634438656
    m_Localized: "Alors que leur dispute interminable se poursuit, les Wizzos se
      retrouvent \xE0 combattre dans la chaleur d'un rago\xFBt fra\xEEchement remu\xE9.\n\n<color=#FFA845>\xC9v\xE9nement
      de la Carte:</color> Des morceaux de Nourriture surgissent du fond, cr\xE9ant
      des motifs changeants de murs et d'obstacles. Des zones extra chaudes et <color=#FFA845>piquantes
      {</color> marquent les Wizzos."
    m_Metadata:
      m_Items: []
  - m_Id: 425184382976
    m_Localized: "Tire une Bulle <color=#86D1F0>rapide</color>\navec une port\xE9e
      moyenne\net un <color=#86D1F0>temps de recharge tr\xE8s court</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 463079919616
    m_Localized: "Tire un Chewing-gum explosif\n\xE0 courte port\xE9e.\nLaisse un
      <color=#FCABFC>champ de ralentissement }</color> derri\xE8re lui."
    m_Metadata:
      m_Items: []
  - m_Id: 492343578624
    m_Localized: "Lance un Missile.\n<color=#FFA975>Explose</color> \xE0 l'impact
      dans une\nzone d'effet."
    m_Metadata:
      m_Items: []
  - m_Id: 521196195840
    m_Localized: "Invoque un B\xE2teau lent \ninfligeant une <color=#7DFFBB>projection
      massive</color>. \nS'il est touch\xE9, se transforme en un Speed-Boat plus
      petit."
    m_Metadata:
      m_Items: []
  - m_Id: 546617872384
    m_Localized: "Lance une Grenade en arc de cercle.\nExplose dans une zone d'effet.\nLaisse
      derri\xE8re elle un <color=#FF7B5C>champ de sauce {</color> qui marque les
      joueurs."
    m_Metadata:
      m_Items: []
  - m_Id: 573285257216
    m_Localized: "Attire les ennemis vers l'int\xE9rieur, d\xE9g\xE2ts mod\xE9r\xE9s"
    m_Metadata:
      m_Items: []
  - m_Id: 602712494080
    m_Localized: "Invoque une Chauve-souris <color=#FF6EF5>t\xE9l\xE9guid\xE9e</color>.
      \nSe verrouille sur les joueurs.\nInflige des d\xE9g\xE2ts \xE0 l'impact\net
      apr\xE8s un court d\xE9lai."
    m_Metadata:
      m_Items: []
  - m_Id: 629505708032
    m_Localized: "D\xE9gaine un Revolver\nd\xE9chargeant <color=#A178FF>6</color>
      petites balles\nen <color=#A178FF>\xE9ventail</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 655795605504
    m_Localized: "Cr\xE9e une paire de Bulles\nqui <color=#FF7D87>tournoient autour</color>
      du joueur.\nLe <color=#FF7D87>second</color> coup sur la m\xEAme cible infligera
      un <color=#FF7D87>coup critique</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 685206065152
    m_Localized: "Tire un coup de Sniper \xE0 <color=#E05C9A>longue port\xE9e</color>.\nLes
      d\xE9g\xE2ts augmentent avec la distance. \n<color=#E05C9A>Perce</color> les
      autres bulles."
    m_Metadata:
      m_Items: []
  - m_Id: 717250547712
    m_Localized: "Lance une goutte de Savon.\nLaisse des <color=#8CA7FC>champs glissants
      $</color> derri\xE8re elle, \naugmentant la vitesse des bulles\net la projection
      des joueurs."
    m_Metadata:
      m_Items: []
  - m_Id: 741921443840
    m_Localized: "Invoque un Murelet mobile.\n<color=#FFF373>Renvoie</color> les
      tirs \xE0 l'impact."
    m_Metadata:
      m_Items: []
  - m_Id: 16121243400871936
    m_Localized: "Projette un Cactus,\nse <color=#BBFF7A>s\xE9parant en deux</color>
      spicules plus dangereuses."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
