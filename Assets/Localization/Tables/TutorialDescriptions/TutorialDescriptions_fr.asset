  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: TutorialDescriptions_fr
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: fr
  m_SharedData: {fileID: 11400000, guid: 787f9328ab1102f4dbe15593b57817be, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 112356413440
    m_Localized: "D\xE9placez-vous, lancez des sorts et foncez pour esquiver les
      attaques et \xE9liminer vos adversaires."
    m_Metadata:
      m_Items: []
  - m_Id: 152374267904
    m_Localized: "Combattez sur plusieurs cartes, gagnez des points en \xE9tant le
      dernier survivant. Le premier \xE0 atteindre la limite de score gagne."
    m_Metadata:
      m_Items: []
  - m_Id: 196011806720
    m_Localized: "Ramassez des sorts, lancez-les pour attaquer, vous d\xE9fendre
      et surpasser vos adversaires. Utilisez-en deux \xE0 la fois pour cr\xE9er des
      combos."
    m_Metadata:
      m_Items: []
  - m_Id: 217025269760
    m_Localized: "Jusqu'\xE0 4 joueurs s'affrontent dans un chacun pour soi, gagnant
      des points en \xE9tant le dernier survivant. Le joueur avec le plus de points
      gagne."
    m_Metadata:
      m_Items: []
  - m_Id: 254539124736
    m_Localized: "Faites \xE9quipe dans des combats en 2v2 ou 3v1 et coop\xE9rez
      pour vaincre l'\xE9quipe adverse."
    m_Metadata:
      m_Items: []
  - m_Id: 282519326720
    m_Localized: "Wizzo Popout est un jeu de tir en ar\xE8ne 3D\\nvue de dessus et
      au rythme effr\xE9n\xE9\\n pour jusqu'\xE0 4 joueurs.\\n\\nLancez des sorts,
      esquivez les explosions et \xE9jectez vos rivaux hors de l'ar\xE8ne."
    m_Metadata:
      m_Items: []
  - m_Id: 319974461440
    m_Localized: "Un vortex tourne autour du centre pendant le combat. Il attire
      les joueurs vers l'int\xE9rieur, ralentit les mouvements et peut tuer s'ils
      sont compl\xE8tement aspir\xE9s."
    m_Metadata:
      m_Items: []
  - m_Id: 354535526400
    m_Localized: "Des poissons nagent \xE0 travers l'ar\xE8ne pendant le combat.
      Ils se d\xE9placent rapidement au centre, bloquant les mouvements et infligeant
      un recul en cas de contact."
    m_Metadata:
      m_Items: []
  - m_Id: 375968419840
    m_Localized: Combattez alors que des gouttes de savon tombent du ciel. Plus le
      match dure, plus le terrain devient glissant et chaotique.
    m_Metadata:
      m_Items: []
  - m_Id: 398634438656
    m_Localized: "De la nourriture surgit d'en bas pendant le combat. Elle appara\xEEt
      al\xE9atoirement, bloque les sorts et inflige un recul en montant."
    m_Metadata:
      m_Items: []
  - m_Id: 425184382976
    m_Localized: "Sort rapide \xE0 courte port\xE9e et faible temps de recharge"
    m_Metadata:
      m_Items: []
  - m_Id: 463079919616
    m_Localized: "Sort de zone infligeant des d\xE9g\xE2ts et un recul"
    m_Metadata:
      m_Items: []
  - m_Id: 492343578624
    m_Localized: "Explose \xE0 l'impact, lourds d\xE9g\xE2ts de zone"
    m_Metadata:
      m_Items: []
  - m_Id: 521196195840
    m_Localized: "Orbe qui r\xE9tr\xE9cit, acc\xE9l\xE8re et inflige un impact puissant"
    m_Metadata:
      m_Items: []
  - m_Id: 546617872384
    m_Localized: "Grenade lob\xE9e avec explosion de malus"
    m_Metadata:
      m_Items: []
  - m_Id: 573285257216
    m_Localized: "Attire les ennemis vers l'int\xE9rieur, d\xE9g\xE2ts mod\xE9r\xE9s"
    m_Metadata:
      m_Items: []
  - m_Id: 602712494080
    m_Localized: "Projectile \xE0 t\xEAte chercheuse \xE0 faibles d\xE9g\xE2ts"
    m_Metadata:
      m_Items: []
  - m_Id: 629505708032
    m_Localized: "Rafale rapide de revolver \xE0 dispersion de six coups"
    m_Metadata:
      m_Items: []
  - m_Id: 655795605504
    m_Localized: Deux projectiles orbitaux avec recul
    m_Metadata:
      m_Items: []
  - m_Id: 685206065152
    m_Localized: "Tir de pr\xE9cision \xE0 longue port\xE9e de type sniper avec \xE9chelonnage"
    m_Metadata:
      m_Items: []
  - m_Id: 717250547712
    m_Localized: "Terrain glissant augmentant la vuln\xE9rabilit\xE9 au recul"
    m_Metadata:
      m_Items: []
  - m_Id: 741921443840
    m_Localized: Mur mobile qui bloque et repousse les ennemis
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
