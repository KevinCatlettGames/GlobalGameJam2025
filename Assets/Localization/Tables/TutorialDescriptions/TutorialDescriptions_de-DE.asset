  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: TutorialDescriptions_de-DE
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: de-DE
  m_SharedData: {fileID: 11400000, guid: 787f9328ab1102f4dbe15593b57817be, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 112356413440
    m_Localized: Bewege dich, wirke Zauber und sprinte, um Angriffen auszuweichen
      und deine Gegner auszuschalten.
    m_Metadata:
      m_Items: []
  - m_Id: 152374267904
    m_Localized: "Nutze deine <color=#FFF8A1>2 Zauber</color>, um Gegner aus der
      Arena zu sto\xDFen.\r\n\r\n<color=#CB98ED>Sammle</color> neue Zauber vom Boden
      auf, um ihre <color=#CB98ED>Abklingzeit</color> zur\xFCckzusetzen.\r\n\r\nTreffe
      Spieler mit Zaubern, um <color=#FF3D5E>Schaden</color>\r\nanzuh\xE4ufen. Je
      mehr Schaden sie\r\nhaben, desto weiter werden\r\nsie <color=#FF3D5E>zur\xFCckgesto\xDFen</color>.
      \r\n\r\nTeste die Zauber auf dem <color=#FFF8A1>Trainingsgel\xE4nde</color>
      aus."
    m_Metadata:
      m_Items: []
  - m_Id: 196011806720
    m_Localized: "Bis zu <color=#CB98ED>4 Spieler</color> treten im <color=#CB98ED>Jeder-gegen-Jeden</color>
      oder in <color=#CB98ED>Team-basierten</color> K\xE4mpfen gegeneinander an.
      \nVerdiene Punkte, indem du der\n<color=#CB98ED>letzte \xDCberlebende</color>
      bist. \nDer Spieler mit den meisten Punkten gewinnt.\n\n\xC4ndere die <color=#FFF8A1>Matcheinstellungen</color>
      in der Lobby, um eigene Runden zu erstellen.\n\nSchalte <color=#FFF8A1>neue
      Wizzos</color> frei, indem du spielst und <color=#FFF8A1>Erfolge</color> abschlie\xDFt."
    m_Metadata:
      m_Items: []
  - m_Id: 217025269760
    m_Localized: "Bis zu 4 Spieler k\xE4mpfen in einem Jeder-gegen-jeden-Modus und
      verdienen Punkte, indem sie als Letzter \xFCberleben. Der Spieler mit den meisten
      Punkten gewinnt."
    m_Metadata:
      m_Items: []
  - m_Id: 254539124736
    m_Localized: "<color=#86D1F0>Rutschig $</color> - Erh\xF6ht den R\xFCcksto\xDF
      auf Spieler und das Tempo von Blasen.\n\n<color=#FFA845>W\xFCrzig {</color>
      - Wendet eine Markierung an. Der n\xE4chste Treffer l\xF6st die Markierung
      aus und verursacht Bonus-Schaden sowie Bonus-R\xFCcksto\xDF.\n\n<color=#FFA1F9>Verlangsamt
      }</color> - Sowohl Wizzos als auch Blasen bewegen sich langsamer. Wizzos k\xF6nnen
      keinen Sprint nutzen."
    m_Metadata:
      m_Items: []
  - m_Id: 282519326720
    m_Localized: "Wizzo Popout ist ein rasanter,\\n3D-Top-Down-Arena-Shooter\\n f\xFCr
      bis zu 4 Spieler.\\n\\nWirke Zauber, weiche Explosionen aus und sto\xDFe deine
      Rivalen aus der Arena."
    m_Metadata:
      m_Items: []
  - m_Id: 319974461440
    m_Localized: "Mitten an einem entspannten Strandtag drehen die Wizzos v\xF6llig
      durch. \nAchtung! An diesem Strand\nist nicht alles so, wie es scheint.\n\n<color=#FF5162>Karten-Event:</color>
      Hinterlistige Muscheln locken die Wizzos mit gef\xE4lschten Gegenst\xE4nden
      an. Wenn man ihnen zu nahe kommt, schnappen die Muscheln zu und verursachen
      erheblichen Schaden."
    m_Metadata:
      m_Items: []
  - m_Id: 354535526400
    m_Localized: "Die Stra\xDFen sind nicht sicher! Eine Gruppe randalierender Wizzos
      tr\xE4gt ihren Konflikt in einer Thunfischdose aus, die mit Regenwasser und
      gruseligen Restecken gef\xFCllt ist.\n\n<color=#5FFF6A>Karten-Event:</color>
      Fischgr\xE4ten kreisen um die Dose und bilden bewegliche Barrieren. Bei Treffern
      prallen sowohl Sch\xFCsse als auch Wizzos ab."
    m_Metadata:
      m_Items: []
  - m_Id: 375968419840
    m_Localized: "Das Wizzo Popout-Original:\nDreckiges Geschirr in der Sp\xFCle
      \nNachdem sie aus Versehen geschrumpft wurden, ist es an der Zeit, ihren Streit
      ein f\xFCr alle Mal zu kl\xE4ren: Wer ist mit Abwaschen dran?\n\n<color=#5FF2FF>Karten-Event:</color>
      Wellen aus seifigem Regen klatschen auf den Teller und hinterlassen einen nassen
      und <color=#5AE2FF>rutschigen $</color> Boden."
    m_Metadata:
      m_Items: []
  - m_Id: 398634438656
    m_Localized: "W\xE4hrend ihr endloser Streit weitergeht, k\xE4mpfen die Wizzos
      in der Hitze eines frisch umger\xFChrten Eintopfs.\n\n<color=#FFA845>Karten-Event:</color>
      Essenst\xFCcke steigen von unten auf und bilden sich stets ver\xE4ndernde Muster
      aus W\xE4nden und Barrieren. Extrem hei\xDFe und <color=#FFA845>w\xFCrzige
      {</color> Zonen markieren Wizzos."
    m_Metadata:
      m_Items: []
  - m_Id: 425184382976
    m_Localized: "Verschie\xDFt eine <color=#86D1F0>schnelle</color> Blase\nmit mittlerer
      Reichweite\nund sehr <color=#86D1F0>kurzer Abklingzeit</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 463079919616
    m_Localized: "Verschie\xDFt ein platzendes Kaugummi\nauf kurze Distanz.\nHinterl\xE4sst
      ein <color=#FCABFC>Verlangsamungsfeld }</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 492343578624
    m_Localized: 'Feuert eine Rakete ab.

      <color=#FFA975>Explodiert</color>
      beim Aufprall in einem

      Wirkungsbereich.'
    m_Metadata:
      m_Items: []
  - m_Id: 521196195840
    m_Localized: "Beschw\xF6rt ein langsames Boot, \ndas <color=#7DFFBB>massiven
      R\xFCcksto\xDF</color> verursacht. \nWird es getroffen, verwandelt es sich
      in das kleinere Schnellboot."
    m_Metadata:
      m_Items: []
  - m_Id: 546617872384
    m_Localized: "Wirft eine Granate im Bogen.\nExplodiert in einem Wirkungsbereich.\nHinterl\xE4sst
      ein <color=#FF7B5C>Saucenfeld {</color>, das Spieler markiert."
    m_Metadata:
      m_Items: []
  - m_Id: 573285257216
    m_Localized: Zieht Gegner nach innen, moderater Schaden
    m_Metadata:
      m_Items: []
  - m_Id: 602712494080
    m_Localized: "Beschw\xF6rt eine <color=#FF6EF5>zielsuchende</color> Fledermaus.
      \nVisiert Spieler an.\nVerursacht Schaden beim Aufprall\nund nach einer kurzen
      Verz\xF6gerung."
    m_Metadata:
      m_Items: []
  - m_Id: 629505708032
    m_Localized: 'Zieht einen Revolver

      und feuert <color=#A178FF>6</color>
      kleine Kugeln

      mit <color=#A178FF>Streuung</color> ab.'
    m_Metadata:
      m_Items: []
  - m_Id: 655795605504
    m_Localized: 'Erzeugt ein Paar Blasen,

      die sich <color=#FF7D87>um den
      Spieler drehen</color>.

      Der <color=#FF7D87>zweite</color> Treffer auf
      dasselbe Ziel landet einen <color=#FF7D87>kritischen Treffer</color>.'
    m_Metadata:
      m_Items: []
  - m_Id: 685206065152
    m_Localized: "Feuert einen Scharfsch\xFCtzenschuss mit <color=#E05C9A>hoher Reichweite</color>
      ab.\nSchaden skaliert mit der Distanz. \n<color=#E05C9A>Durchschl\xE4gt</color>
      andere Blasen."
    m_Metadata:
      m_Items: []
  - m_Id: 717250547712
    m_Localized: "Wirft einen Tropfen Seife.\nHinterl\xE4sst <color=#8CA7FC>rutschige
      Felder $</color>, \ndie das Tempo von Blasen\nund den R\xFCcksto\xDF auf Spieler
      erh\xF6hen."
    m_Metadata:
      m_Items: []
  - m_Id: 741921443840
    m_Localized: "Beschw\xF6rt eine sich bewegende Wand.\n<color=#FFF373>Reflektiert</color>
      Sch\xFCsse beim Aufprall."
    m_Metadata:
      m_Items: []
  - m_Id: 16121243400871936
    m_Localized: "Schleudert ein Kaktus-Projektil,\ndas sich in zwei gef\xE4hrlichere
      Stacheln <color=#BBFF7A>aufteilt</color>."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
