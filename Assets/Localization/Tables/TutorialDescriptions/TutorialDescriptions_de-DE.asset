  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: TutorialDescriptions_de-DE
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: de-DE
  m_SharedData: {fileID: 11400000, guid: 787f9328ab1102f4dbe15593b57817be, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 112356413440
    m_Localized: Bewege dich, wirke Zauber und sprinte, um Angriffen auszuweichen
      und deine Gegner auszuschalten.
    m_Metadata:
      m_Items: []
  - m_Id: 152374267904
    m_Localized: "K\xE4mpfe auf verschiedenen Karten und verdiene Punkte, indem du
      als Letzter \xFCberlebst. Wer das Punktelimit zuerst erreicht, gewinnt."
    m_Metadata:
      m_Items: []
  - m_Id: 196011806720
    m_Localized: "Sammle Zauber auf, wirke sie, um anzugreifen, dich zu verteidigen
      und Gegner zu \xFCberlisten. Nutze zwei gleichzeitig, um Combos aufzubauen."
    m_Metadata:
      m_Items: []
  - m_Id: 217025269760
    m_Localized: "Bis zu 4 Spieler k\xE4mpfen in einem Jeder-gegen-jeden-Modus und
      verdienen Punkte, indem sie als Letzter \xFCberleben. Der Spieler mit den meisten
      Punkten gewinnt."
    m_Metadata:
      m_Items: []
  - m_Id: 254539124736
    m_Localized: "Schlie\xDFe dich in 2v2- oder 3v1-K\xE4mpfen zusammen und arbeitet
      gemeinsam daran, das gegnerische Team zu besiegen."
    m_Metadata:
      m_Items: []
  - m_Id: 282519326720
    m_Localized: "Wizzo Popout ist ein rasanter,\\n3D-Top-Down-Arena-Shooter\\n f\xFCr
      bis zu 4 Spieler.\\n\\nWirke Zauber, weiche Explosionen aus und sto\xDFe deine
      Rivalen aus der Arena."
    m_Metadata:
      m_Items: []
  - m_Id: 319974461440
    m_Localized: "W\xE4hrend des Kampfes bewegt sich ein Wirbel um das Zentrum. Er
      zieht Spieler nach innen, verlangsamt die Bewegung und ist t\xF6dlich, wenn
      man vollst\xE4ndig hineingezogen wird."
    m_Metadata:
      m_Items: []
  - m_Id: 354535526400
    m_Localized: "W\xE4hrend des Kampfes schwimmen Fische durch die Arena. Sie bewegen
      sich schnell durch das Zentrum, blockieren die Bewegung und verursachen bei
      Kontakt einen R\xFCcksto\xDF."
    m_Metadata:
      m_Items: []
  - m_Id: 375968419840
    m_Localized: "K\xE4mpfe, w\xE4hrend Seifentropfen von oben herabregnen. Je l\xE4nger
      das Match dauert, desto rutschiger und chaotischer wird es."
    m_Metadata:
      m_Items: []
  - m_Id: 398634438656
    m_Localized: "W\xE4hrend des Kampfes steigt Essen von unten auf. Es erscheint
      zuf\xE4llig, blockiert Zauber und verursacht beim Aufsteigen einen R\xFCcksto\xDF."
    m_Metadata:
      m_Items: []
  - m_Id: 425184382976
    m_Localized: "Schie\xDFt eine <color=#86D1F0>schnelle</color> Blase \nmit mittlerer
      Reichweite und \nsehr <color=#86D1F0>kurzer Abklingzeit</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 463079919616
    m_Localized: "Schaden verursachender Fl\xE4chenzauber mit R\xFCcksto\xDF"
    m_Metadata:
      m_Items: []
  - m_Id: 492343578624
    m_Localized: "Explodiert beim Aufprall, hoher Fl\xE4chenschaden"
    m_Metadata:
      m_Items: []
  - m_Id: 521196195840
    m_Localized: Schrumpfende, beschleunigende Kugel mit hoher Wucht
    m_Metadata:
      m_Items: []
  - m_Id: 546617872384
    m_Localized: "Geworfene Granate mit Schw\xE4chungsexplosion"
    m_Metadata:
      m_Items: []
  - m_Id: 573285257216
    m_Localized: Zieht Gegner nach innen, moderater Schaden
    m_Metadata:
      m_Items: []
  - m_Id: 602712494080
    m_Localized: Zielsuchendes Projektil mit geringem Schaden
    m_Metadata:
      m_Items: []
  - m_Id: 629505708032
    m_Localized: Schneller Sechs-Schuss-Revolversalve mit Streuung
    m_Metadata:
      m_Items: []
  - m_Id: 655795605504
    m_Localized: "Zwei kreisende Projektile mit R\xFCcksto\xDF"
    m_Metadata:
      m_Items: []
  - m_Id: 685206065152
    m_Localized: "Pr\xE4ziser Scharfsch\xFCtzenschuss mit hoher Reichweite und Skalierung"
    m_Metadata:
      m_Items: []
  - m_Id: 717250547712
    m_Localized: "Rutschiges Feld, das die R\xFCcksto\xDFanf\xE4lligkeit erh\xF6ht"
    m_Metadata:
      m_Items: []
  - m_Id: 741921443840
    m_Localized: "Vorr\xFCckende Wand, die Gegner blockiert und wegst\xF6\xDFt"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
