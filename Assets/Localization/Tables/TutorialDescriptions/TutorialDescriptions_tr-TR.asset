  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: TutorialDescriptions_tr-TR
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: tr-TR
  m_SharedData: {fileID: 11400000, guid: 787f9328ab1102f4dbe15593b57817be, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 112356413440
    m_Localized: "Hareket et, b\xFCy\xFC yap ve sald\u0131r\u0131lardan s\u0131yr\u0131l\u0131p
      rakiplerini nakavt etmek i\xE7in at\u0131l."
    m_Metadata:
      m_Items: []
  - m_Id: 152374267904
    m_Localized: "Farkl\u0131 haritalarda sava\u015F, hayatta kalan son oyuncu olarak
      puanlar\u0131 topla. Skor limitine ilk ula\u015Fan kazan\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 196011806720
    m_Localized: "B\xFCy\xFCleri topla; sald\u0131rmak, savunma yapmak ve rakiplerini
      alt etmek i\xE7in kullan. Kombolar yapmak i\xE7in ikisini ayn\u0131 anda kullan."
    m_Metadata:
      m_Items: []
  - m_Id: 217025269760
    m_Localized: "En fazla 4 oyuncu herkesin tek oldu\u011Fu bir modda sava\u015F\u0131r,
      hayatta kalan son ki\u015Fi olarak puan kazan\u0131r. En \xE7ok puan\u0131
      alan oyuncu kazan\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 254539124736
    m_Localized: "2v2 veya 3v1 sava\u015Flarda tak\u0131m kur ve rakip tak\u0131m\u0131
      alt etmek i\xE7in birlikte \xE7al\u0131\u015F."
    m_Metadata:
      m_Items: []
  - m_Id: 282519326720
    m_Localized: "Wizzo Popout, en fazla 4 oyuncu i\xE7in\\ntempolu, 3D ku\u015F
      bak\u0131\u015F\u0131 bir arena ni\u015Fanc\u0131 oyunudur.\\n\\nB\xFCy\xFCler
      yap, patlamalardan s\u0131yr\u0131l ve rakiplerini arenan\u0131n d\u0131\u015F\u0131na
      f\u0131rlat."
    m_Metadata:
      m_Items: []
  - m_Id: 319974461440
    m_Localized: "Sava\u015F s\u0131ras\u0131nda merkezin etraf\u0131nda bir girdap
      d\xF6ner. Oyuncular\u0131 i\xE7eri \xE7eker, hareketi yava\u015Flat\u0131r
      ve tamamen i\xE7ine \xE7ekilirseniz \xF6ld\xFCrebilir."
    m_Metadata:
      m_Items: []
  - m_Id: 354535526400
    m_Localized: "Sava\u015F s\u0131ras\u0131nda arenada bal\u0131klar y\xFCzer.
      Merkezin i\xE7inden h\u0131zla ge\xE7erek hareketi engellerler ve temas halinde
      geri itme uygularlar."
    m_Metadata:
      m_Items: []
  - m_Id: 375968419840
    m_Localized: "Yukar\u0131dan sabun damlalar\u0131 ya\u011Farken sava\u015F. Ma\xE7
      uzad\u0131k\xE7a ortam daha kaygan ve kaotik bir h\xE2l al\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 398634438656
    m_Localized: "Sava\u015F s\u0131ras\u0131nda a\u015Fa\u011F\u0131dan yiyecekler
      y\xFCkselir. Rastgele belirirler, b\xFCy\xFCleri engellerler ve y\xFCkselirken
      geri itme uygularlar."
    m_Metadata:
      m_Items: []
  - m_Id: 425184382976
    m_Localized: "H\u0131zl\u0131, yak\u0131n menzilli ve k\u0131sa bekleme s\xFCreli
      b\xFCy\xFC"
    m_Metadata:
      m_Items: []
  - m_Id: 463079919616
    m_Localized: "Hasar veren, alan etkili ve geri itmeli b\xFCy\xFC"
    m_Metadata:
      m_Items: []
  - m_Id: 492343578624
    m_Localized: "\xC7arpma an\u0131nda patlar, y\xFCksek alan hasar\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 521196195840
    m_Localized: "K\xFC\xE7\xFClen, h\u0131zlanan ve y\xFCksek darbe vuran k\xFCre"
    m_Metadata:
      m_Items: []
  - m_Id: 546617872384
    m_Localized: "Zay\u0131flatma etkili patlamaya sahip, kavisli f\u0131rlat\u0131lan
      el bombas\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 573285257216
    m_Localized: "D\xFC\u015Fmanlar\u0131 i\xE7eri \xE7eker, orta derece hasar"
    m_Metadata:
      m_Items: []
  - m_Id: 602712494080
    m_Localized: "G\xFCd\xFCml\xFC, d\xFC\u015F\xFCk hasarl\u0131 mermi"
    m_Metadata:
      m_Items: []
  - m_Id: 629505708032
    m_Localized: "Alt\u0131 at\u0131\u015Fl\u0131k, h\u0131zl\u0131 ve yay\u0131l\u0131ml\u0131
      toplu tabanca patlamas\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 655795605504
    m_Localized: "Y\xF6r\xFCngede d\xF6nen iki geri itmeli mermi"
    m_Metadata:
      m_Items: []
  - m_Id: 685206065152
    m_Localized: "Uzun menzilli, y\xFCksek isabetli ve \xF6l\xE7eklenen keskin ni\u015Fanc\u0131
      at\u0131\u015F\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 717250547712
    m_Localized: "Geri itme hassasiyetini art\u0131ran kaygan alan"
    m_Metadata:
      m_Items: []
  - m_Id: 741921443840
    m_Localized: "\u0130lerleyen, d\xFC\u015Fmanlar\u0131 engelleyen ve iten duvar"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
