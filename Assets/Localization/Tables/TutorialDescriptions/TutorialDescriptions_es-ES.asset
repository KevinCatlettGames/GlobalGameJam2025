  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: TutorialDescriptions_es-ES
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: es-ES
  m_SharedData: {fileID: 11400000, guid: 787f9328ab1102f4dbe15593b57817be, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 112356413440
    m_Localized: "Mu\xE9vete, lanza hechizos y esquiva con el impulso para evitar
      ataques y noquear a tus oponentes."
    m_Metadata:
      m_Items: []
  - m_Id: 152374267904
    m_Localized: "Lucha en m\xFAltiples mapas y gana puntos siendo el \xFAltimo jugador
      en pie. El primero en alcanzar el l\xEDmite de puntuaci\xF3n gana."
    m_Metadata:
      m_Items: []
  - m_Id: 196011806720
    m_Localized: "Recoge hechizos, l\xE1nzalos para atacar, defenderte y superar
      a tus oponentes. Usa dos a la vez para crear combos."
    m_Metadata:
      m_Items: []
  - m_Id: 217025269760
    m_Localized: "Hasta 4 jugadores luchan en un todos contra todos, ganando puntos
      al ser el \xFAltimo en pie. El jugador con m\xE1s puntos gana."
    m_Metadata:
      m_Items: []
  - m_Id: 254539124736
    m_Localized: Forma equipo en batallas de 2 contra 2 o 3 contra 1 y cooperad para
      derrotar al equipo contrario.
    m_Metadata:
      m_Items: []
  - m_Id: 282519326720
    m_Localized: "Wizzo Popout es un fren\xE9tico\\nshooter de arena en 3D con vista
      cenital\\n para hasta 4 jugadores.\\n\\nLanza hechizos, esquiva explosiones
      y expulsa a tus rivales de la arena."
    m_Metadata:
      m_Items: []
  - m_Id: 319974461440
    m_Localized: "Un v\xF3rtice se mueve alrededor del centro durante el combate.
      Atrae a los jugadores hacia el interior, ralentiza el movimiento y puede matarte
      si te succiona por completo."
    m_Metadata:
      m_Items: []
  - m_Id: 354535526400
    m_Localized: "Varios peces nadan por la arena durante el combate. Se mueven r\xE1pido
      por el centro, bloqueando el movimiento y aplicando empuje al impactar."
    m_Metadata:
      m_Items: []
  - m_Id: 375968419840
    m_Localized: "Lucha mientras llueven gotas de jab\xF3n desde arriba. Cuanto m\xE1s
      dure la partida, m\xE1s resbaladiza y ca\xF3tica se volver\xE1."
    m_Metadata:
      m_Items: []
  - m_Id: 398634438656
    m_Localized: La comida asciende desde abajo durante el combate. Aparece de forma
      aleatoria, bloquea hechizos y aplica empuje a medida que sube.
    m_Metadata:
      m_Items: []
  - m_Id: 425184382976
    m_Localized: "Hechizo r\xE1pido de corto alcance y bajo tiempo de recarga"
    m_Metadata:
      m_Items: []
  - m_Id: 463079919616
    m_Localized: "Hechizo de \xE1rea de efecto con da\xF1o y empuje"
    m_Metadata:
      m_Items: []
  - m_Id: 492343578624
    m_Localized: "Explota al impactar, gran da\xF1o de \xE1rea"
    m_Metadata:
      m_Items: []
  - m_Id: 521196195840
    m_Localized: Orbe que se encoge, acelera e impacta con fuerza
    m_Metadata:
      m_Items: []
  - m_Id: 546617872384
    m_Localized: "Granada parab\xF3lica con explosi\xF3n de perjuicio"
    m_Metadata:
      m_Items: []
  - m_Id: 573285257216
    m_Localized: "Atrae a los enemigos hacia el interior, da\xF1o moderado"
    m_Metadata:
      m_Items: []
  - m_Id: 602712494080
    m_Localized: "Proyectil teledirigido de poco da\xF1o"
    m_Metadata:
      m_Items: []
  - m_Id: 629505708032
    m_Localized: "R\xE1faga r\xE1pida de rev\xF3lver de seis disparos con dispersi\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 655795605504
    m_Localized: Dos proyectiles orbitales con empuje
    m_Metadata:
      m_Items: []
  - m_Id: 685206065152
    m_Localized: "Disparo de francotirador de largo alcance, precisi\xF3n y da\xF1o
      progresivo"
    m_Metadata:
      m_Items: []
  - m_Id: 717250547712
    m_Localized: Campo resbaladizo que aumenta la vulnerabilidad al empuje
    m_Metadata:
      m_Items: []
  - m_Id: 741921443840
    m_Localized: Muro en avance que bloquea y empuja a los enemigos
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
