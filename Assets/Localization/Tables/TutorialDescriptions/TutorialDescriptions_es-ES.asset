  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: TutorialDescriptions_es-ES
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: es-ES
  m_SharedData: {fileID: 11400000, guid: 787f9328ab1102f4dbe15593b57817be, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 112356413440
    m_Localized: "Mu\xE9vete, lanza hechizos y esquiva con el impulso para evitar
      ataques y noquear a tus oponentes."
    m_Metadata:
      m_Items: []
  - m_Id: 152374267904
    m_Localized: "Usa tus <color=#FFF8A1>2 Hechizos</color> para expulsar a los Oponentes
      de la Arena.\r\n\r\n<color=#CB98ED>Recoge</color> nuevos Hechizos del Suelo,
      esto reiniciar\xE1 su <color=#CB98ED>Tiempo de recarga</color>.\r\n\r\nGolpea
      a los Jugadores con Hechizos para acumular\r\n<color=#FF3D5E>Da\xF1o</color>.
      Cuanto m\xE1s Da\xF1o\r\ntengan, m\xE1s lejos ser\xE1n<color=#FF3D5E> empujados</color>.
      \r\n\r\nPrueba los Hechizos en el <color=#FFF8A1>Campo de entrenamiento</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 196011806720
    m_Localized: "Hasta <color=#CB98ED>4 Jugadores</color> compiten en combates de
      <color=#CB98ED>todos contra todos</color> o por <color=#CB98ED>Equipos</color>.
      \nGana Puntos siendo el\n<color=#CB98ED>\xFAltimo en pie</color>. \nEl Jugador
      con m\xE1s Puntos gana.\n\nCambia los <color=#FFF8A1>Ajustes de la partida</color>
      en la Sala para crear Rondas personalizadas.\n\nDesbloquea <color=#FFF8A1>nuevos
      Wizzos</color> jugando y completando <color=#FFF8A1>Logros</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 217025269760
    m_Localized: "Hasta 4 jugadores luchan en un todos contra todos, ganando puntos
      al ser el \xFAltimo en pie. El jugador con m\xE1s puntos gana."
    m_Metadata:
      m_Items: []
  - m_Id: 254539124736
    m_Localized: "<color=#86D1F0>Resbaladizo $</color> - Aumenta el Empuje sobre
      los Jugadores y la Velocidad de las Burbujas.\n\n<color=#FFA845>Picante {</color>
      - Aplica una Marca. El siguiente golpe activar\xE1 la Marca infligiendo Da\xF1o
      y Empuje adicional.\n\n<color=#FFA1F9>Lentitud }</color> - Tanto los Wizzos
      como las Burbujas se mueven m\xE1s despacio. Los Wizzos no pueden usar el Impulso."
    m_Metadata:
      m_Items: []
  - m_Id: 282519326720
    m_Localized: "Wizzo Popout es un fren\xE9tico\\nshooter de arena en 3D con vista
      cenital\\n para hasta 4 jugadores.\\n\\nLanza hechizos, esquiva explosiones
      y expulsa a tus rivales de la arena."
    m_Metadata:
      m_Items: []
  - m_Id: 319974461440
    m_Localized: "En mitad de un relajante d\xEDa de playa, los Wizzos pierden el
      control. \n\xA1Cuidado! En esta playa\nnada es lo que parece.\n\n<color=#FF5162>Evento
      del Mapa:</color> Almejas astutas atraen a los Wizzos con objetos falsos. Al
      acercarse demasiado, las Almejas se cerrar\xE1n de golpe, infligiendo un da\xF1o
      considerable."
    m_Metadata:
      m_Items: []
  - m_Id: 354535526400
    m_Localized: "\xA1Las calles no son seguras! Un grupo de Wizzos alborotadores
      resuelve sus diferencias en una lata de at\xFAn llena de agua de lluvia y restos
      espeluznantes.\n\n<color=#5FFF6A>Evento del Mapa:</color> Espinas de pescado
      giran alrededor de la Lata, creando barreras m\xF3viles. Al impactar, rebotan
      tanto los disparos como a los Wizzos."
    m_Metadata:
      m_Items: []
  - m_Id: 375968419840
    m_Localized: "El original de Wizzo Popout:\nPlatos sucios en el fregadero de
      la cocina \nTras encoger por accidente, ha llegado la hora de resolver su disputa
      de una vez por todas: \xBFa qui\xE9n le toca limpiar?\n\n<color=#5AE2FF>Evento
      del Mapa:</color> Olas de Lluvia con jab\xF3n salpican el plato dejando el
      suelo mojado y <color=#5AE2FF>resbaladizo $</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 398634438656
    m_Localized: "Mientras su discusi\xF3n sin fin contin\xFAa, los Wizzos se ven
      luchando en el calor de un estofado reci\xE9n removido.\n\n<color=#FFA845>Evento
      del Mapa:</color> Trozos de Comida emergen desde abajo, creando patrones cambiantes
      de muros y barreras. Las zonas extra calientes y <color=#FFA845>picantes {</color>
      marcan a los Wizzos."
    m_Metadata:
      m_Items: []
  - m_Id: 425184382976
    m_Localized: "Dispara una Burbuja <color=#86D1F0>r\xE1pida</color>\nde alcance
      medio\ny <color=#86D1F0>tiempo de recarga muy bajo</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 463079919616
    m_Localized: "Lanza un Chicle explosivo\na corta distancia.\nDeja un <color=#FCABFC>campo
      de \nralentizaci\xF3n }</color> a su paso."
    m_Metadata:
      m_Items: []
  - m_Id: 492343578624
    m_Localized: "Lanza un Misil.\n<color=#FFA975>Explota</color> al impactar en
      un\n\xE1rea de efecto."
    m_Metadata:
      m_Items: []
  - m_Id: 521196195840
    m_Localized: "Invoca un Barco lento \nque inflige un <color=#7DFFBB>empuje masivo</color>.
      \nAl recibir un golpe, se transforma en la Lancha r\xE1pida m\xE1s peque\xF1a."
    m_Metadata:
      m_Items: []
  - m_Id: 546617872384
    m_Localized: "Lanza una Granada en arco.\nExplota en un \xE1rea de efecto.\nDeja
      un <color=#FF7B5C>campo de salsa {</color> a su paso que marca a los jugadores."
    m_Metadata:
      m_Items: []
  - m_Id: 573285257216
    m_Localized: "Atrae a los enemigos hacia el interior, da\xF1o moderado"
    m_Metadata:
      m_Items: []
  - m_Id: 602712494080
    m_Localized: "Invoca un Murci\xE9lago <color=#FF6EF5>teleguiado</color>. \nFija
      su objetivo en los jugadores.\nInflige da\xF1o al impactar\ny tras un breve
      retraso."
    m_Metadata:
      m_Items: []
  - m_Id: 629505708032
    m_Localized: "Saca un Rev\xF3lver\ndescargando <color=#A178FF>6</color> balas
      peque\xF1as\ncon <color=#A178FF>dispersi\xF3n</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 655795605504
    m_Localized: "Crea un par de Burbujas\nque <color=#FF7D87>giran alrededor</color>
      del jugador.\nEl <color=#FF7D87>segundo</color> golpe al mismo objetivo infligir\xE1
      un <color=#FF7D87>golpe cr\xEDtico</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 685206065152
    m_Localized: "Efect\xFAa un disparo de Francotirador a <color=#E05C9A>largo alcance</color>.\nEl
      da\xF1o escala con la distancia. \n<color=#E05C9A>Atraviesa</color> otras burbujas."
    m_Metadata:
      m_Items: []
  - m_Id: 717250547712
    m_Localized: "Lanza una gota de Jab\xF3n.\nDeja <color=#8CA7FC>campos resbaladizos
      $</color> a su paso \naumentando la velocidad de las burbujas\ny el empuje
      sobre los jugadores."
    m_Metadata:
      m_Items: []
  - m_Id: 741921443840
    m_Localized: 'Invoca un Muro en movimiento.

      <color=#FFF373>Refleja</color>
      disparos al impactar.'
    m_Metadata:
      m_Items: []
  - m_Id: 16121243400871936
    m_Localized: "Lanza un proyectil de Cactus,\nque se <color=#BBFF7A>divide en
      dos</color> espinas m\xE1s peligrosas."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
