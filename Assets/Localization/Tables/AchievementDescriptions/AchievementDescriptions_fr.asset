  - m_Id: 283117155176448
    m_Localized: "Touchez un m\xEAme cible 3 fois avec les six bulles de revolver."
    m_Metadata:
      m_Items: []
  - m_Id: 283134230188032
    m_Localized: "Appliquez l'effet Ensauc\xE9 (vuln\xE9rable) 10 fois."
    m_Metadata:
      m_Items: []
  - m_Id: 283156443222016
    m_Localized: Ratez 300 tirs.
    m_Metadata:
      m_Items: []
  - m_Id: 283175003017216
    m_Localized: "\xC9liminez 3 joueurs en utilisant le petit bateau."
    m_Metadata:
      m_Items: []
  - m_Id: 283201238388736
    m_Localized: "Touchez un joueur avec 3 armes diff\xE9rentes d'affil\xE9e (sans
      rater aucun tir entre-temps)."
    m_Metadata:
      m_Items: []
  - m_Id: 283222046330880
    m_Localized: "Infligez 500 points de d\xE9g\xE2ts avec des tirs de sniper \xE0
      port\xE9e maximale."
    m_Metadata:
      m_Items: []
  - m_Id: 283242850078720
    m_Localized: "Effectuez un dash pour revenir de l'ext\xE9rieur de la carte 20
      fois."
    m_Metadata:
      m_Items: []
  - m_Id: 283257643388928
    m_Localized: "\xC9jectez le bot d'entra\xEEnement de la carte d'essai une fois
      avec chaque arme."
    m_Metadata:
      m_Items: []
  - m_Id: 283327570825216
    m_Localized: "D\xE9fi cach\xE9"
    m_Metadata:
      m_Items: []
