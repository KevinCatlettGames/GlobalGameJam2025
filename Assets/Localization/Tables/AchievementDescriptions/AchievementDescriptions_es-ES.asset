  m_TableData:
  - m_Id: 283117155176448
    m_Localized: "Impacta a un mismo objetivo 3 veces con las seis burbujas del rev\xF3lver."
    m_Metadata:
      m_Items: []
  - m_Id: 283134230188032
    m_Localized: Aplica el efecto Ensalsado (vulnerable) 10 veces.
    m_Metadata:
      m_Items: []
  - m_Id: 283156443222016
    m_Localized: Falla 300 disparos.
    m_Metadata:
      m_Items: []
  - m_Id: 283175003017216
    m_Localized: "Elimina a 3 jugadores usando la barca peque\xF1a."
    m_Metadata:
      m_Items: []
  - m_Id: 283201238388736
    m_Localized: "Impacta a un jugador con 3 armas diferentes seguidas (sin fallar
      ning\xFAn disparo de por medio)."
    m_Metadata:
      m_Items: []
  - m_Id: 283222046330880
    m_Localized: "Inflige 500 de da\xF1o con disparos de francotirador a distancia
      m\xE1xima."
    m_Metadata:
      m_Items: []
  - m_Id: 283242850078720
    m_Localized: Haz un arremetida/dash de vuelta desde fuera del mapa 20 veces.
    m_Metadata:
      m_Items: []
  - m_Id: 283257643388928
    m_Localized: Expulsa al bot de entrenamiento fuera del mapa de pruebas una vez
      con cada arma.
    m_Metadata:
      m_Items: []
  - m_Id: 283327570825216
    m_Localized: "Desaf\xEDo oculto"
    m_Metadata:
      m_Items: []
