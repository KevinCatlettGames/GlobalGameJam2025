  m_TableData:
  - m_Id: 283117155176448
    m_Localized: Colpisci uno stesso bersaglio 3 volte con tutte e sei le bolle del
      revolver.
    m_Metadata:
      m_Items: []
  - m_Id: 283134230188032
    m_Localized: Attiva l'effetto "Sauced" (vulnerabile) 10 volte.
    m_Metadata:
      m_Items: []
  - m_Id: 283156443222016
    m_Localized: Manca 300 colpi.
    m_Metadata:
      m_Items: []
  - m_Id: 283175003017216
    m_Localized: Uccidi 3 giocatori usando la barca piccola.
    m_Metadata:
      m_Items: []
  - m_Id: 283201238388736
    m_Localized: Colpisci un giocatore con 3 armi diverse di fila (senza mancare
      un colpo nel mezzo).
    m_Metadata:
      m_Items: []
  - m_Id: 283222046330880
    m_Localized: Infliggi 500 danni con colpi di cecchino a portata massima.
    m_Metadata:
      m_Items: []
  - m_Id: 283242850078720
    m_Localized: Scatta per rientrare da fuori mappa 20 volte.
    m_Metadata:
      m_Items: []
  - m_Id: 283257643388928
    m_Localized: Spingi il bot d'addestramento fuori dalla mappa di prova una volta
      con ogni arma.
    m_Metadata:
      m_Items: []
  - m_Id: 283327570825216
    m_Localized: Sfida nascosta
    m_Metadata:
      m_Items: []
  - m_Id: 283344184463360
    m_Localized: Sfida nascosta
