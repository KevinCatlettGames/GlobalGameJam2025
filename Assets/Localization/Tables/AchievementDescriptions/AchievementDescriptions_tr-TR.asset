  m_TableData:
  - m_Id: 283117155176448
    m_Localized: "Tek bir hedefe alt\u0131 Alt\u0131patlar Baloncu\u011Funun hepsini
      3 kez isabet ettir."
    m_Metadata:
      m_Items: []
  - m_Id: 283134230188032
    m_Localized: "Soslu (savunmas\u0131z) etkisini 10 kez tetikle."
    m_Metadata:
      m_Items: []
  - m_Id: 283156443222016
    m_Localized: "300 at\u0131\u015F ka\xE7\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 283175003017216
    m_Localized: "K\xFC\xE7\xFCk tekneyi kullanarak 3 oyuncu \xF6ld\xFCr."
    m_Metadata:
      m_Items: []
  - m_Id: 283201238388736
    m_Localized: "Bir oyuncuya \xFCst \xFCste 3 farkl\u0131 silahla vur (arada hi\xE7
      \u0131ska ge\xE7meden)."
    m_Metadata:
      m_Items: []
  - m_Id: 283222046330880
    m_Localized: "Azami menzil kesin ni\u015Fanc\u0131 vuru\u015Flar\u0131yla 500
      hasar ver."
    m_Metadata:
      m_Items: []
  - m_Id: 283242850078720
    m_Localized: "Haritan\u0131n d\u0131\u015F\u0131ndan i\xE7eri do\u011Fru 20 kez
      at\u0131l."
    m_Metadata:
      m_Items: []
  - m_Id: 283257643388928
    m_Localized: "Antrenman botunu her silahla birer kez test haritas\u0131n\u0131n
      d\u0131\u015F\u0131na f\u0131rlat."
    m_Metadata:
      m_Items: []
  - m_Id: 283327570825216
    m_Localized: Gizli Meydan Okuma
    m_Metadata:
      m_Items: []
